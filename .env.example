# Copy to .env.local for development. No secrets belong in NEXT_PUBLIC_ variables.
APP_URL=http://127.0.0.1:3000
DATABASE_PATH=data/order-rescue.sqlite
DATA_MODE=simulation
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=inferhub/deepseek-v4.1-flash
