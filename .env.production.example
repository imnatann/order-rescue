# Copy to .env.production on the deployment host; never commit the populated file.
APP_URL=https://orders.example.com
DATA_MODE=operations
DATABASE_PATH=/app/data/order-rescue.sqlite
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_API_KEY=
LLM_MODEL=inferhub/deepseek-v4.1-flash
# Optional for first bootstrap only; omit password to generate a unique one.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=
